```nim
## output_sanitizer — strip thought tags and mask secrets before user delivery.
##
## Pipeline topology (pipeops):
##   text |> stripThoughtTags |> maskSecrets  -- unary transform chain
##   text |> cleanResponse                     -- main entry point

import std/strutils
import ./pipeops
import ./security/secret_scan

const ThoughtTagPairs = [
  ("<thinking>", "</thinking>"),
  ("<think>", "</think>"),
]

func stripTagPair*(open, close, text: string): string =
  ## Removes all occurrences of open...close (case-sensitive).
  ## If a closing tag is missing, everything from the opening tag is stripped.
  ## Designed for |>-> piping: text |>-> stripTagPair("<thinking>", "</thinking>")
  var pos = 0
  while pos < text.len:
    let startIdx = text.find(open, pos)
    if startIdx < 0:
      result.add(text[pos .. ^1])
      break
    result.add(text[pos ..< startIdx])
    let closeIdx = text.find(close, startIdx + open.len)
    if closeIdx < 0:
      break  # no closing tag; strip everything after
    pos = closeIdx + close.len

func stripThoughtTags*(text: string): string =
  ## Removes all internal thought tag blocks from text.
  ## Strips <thinking>...</thinking> and <think>...</think>.
  result = text
  for (open, close) in ThoughtTagPairs:
    result = result |>-> stripTagPair(open, close)

func isSecretToken(s: string): bool =
  (s |> scanForSecrets).len > 0

func maskSecrets*(text: string): string =
  ## Replaces secret-looking tokens with [REDACTED].
  ## Uses the same tokenizer as secret_scan for consistency.
  var current = ""
  for c in text:
    if c in {' ', '\t', '\n', '\r', '"', '\'', ',', ';', '(', ')', '[', ']', '{', '}'}:
      if current.len > 0:
        result.add(if isSecretToken(current): "[REDACTED]" else: current)
        current = ""
      result.add(c)
    else:
      current.add(c)
  if current.len > 0:
    result.add(if isSecretToken(current): "[REDACTED]" else: current)

func cleanResponse*(text: string): string =
  ## Strips thought tags and masks secrets in one pipeline pass.
  ## Main entry point for sanitizing LLM responses before user delivery.
  text |> stripThoughtTags |> maskSecrets
```

