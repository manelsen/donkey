# __APP_NAME__ configuration — copy to /etc/__APP_SLUG__/__CONFIG_FILE_NAME__ and adjust as needed.
# Most values have sensible defaults and can be omitted.

[__CONFIG_SECTION_NAME__]
# log_level = "info"    # debug | info | warn | error
# log_file  = ""        # leave empty to log to stderr (captured by journald)
# paddocks  = ""        # defaults to $DONKEY_HOME/paddocks

[sandbox]
# mode    = "none"      # "none" (workdir only), "oci" (ephemeral container) or "wasm"
# runtime = "docker"    # OCI runtime CLI used when mode = "oci"
# image   = "alpine"    # Container image used when mode = "oci"
# allow_host_fallback = false  # set true only if you explicitly accept host exec when OCI fails
# allow_network = false        # keep off unless shell access really needs egress
# read_only_rootfs = true      # keeps container root read-only outside /workspace and /tmp
