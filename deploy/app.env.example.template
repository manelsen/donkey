# __APP_NAME__ environment — copy to /etc/__APP_SLUG__/__ENV_FILE_NAME__ and fill in values.
# Permissions: chmod 600 /etc/__APP_SLUG__/__ENV_FILE_NAME__
#
# Required: at least one channel token + at least one provider key.
# All other variables are optional.

# ── Data directory ────────────────────────────────────────────────────────────
DONKEY_HOME=/var/lib/__APP_SLUG__

# ── Channels (enable the ones you use) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# ── Providers (enable the ones you use) ──────────────────────────────────────
ZAI_API_KEY=
ZAI_CODING_API_KEY=
ZAI_ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# ── Optional features ─────────────────────────────────────────────────────────
# Brave Search API key (used by web search native tool)
BRAVE_API_KEY=

# PostgreSQL DSN for larger graph-backed installs
# Leave unset for the default SQLite-first runtime.
# Format: host=localhost port=5432 dbname=__APP_SLUG__ user=__APP_SLUG__ password=...
# DONKEY_PG_DSN=

# Optional SQLite runtime overrides
# DONKEY_MAGMA_SQLITE_PATH=/var/lib/__APP_SLUG__/state/magma.sqlite
# DONKEY_SQLITE_VEC_PATH=/absolute/path/to/vec0
