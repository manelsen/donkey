# Donkey environment — copy to /etc/donkey/donkey.env and fill in values.
# Permissions: chmod 600 /etc/donkey/donkey.env
#
# Required: at least one channel token + at least one provider key.
# All other variables are optional.

# ── Data directory ────────────────────────────────────────────────────────────
DONKEY_HOME=/var/lib/donkey

# ── Channels (enable the ones you use) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# ── Providers (enable the ones you use) ──────────────────────────────────────
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# ── Optional features ─────────────────────────────────────────────────────────
# Brave Search API key (used by web search native tool)
BRAVE_API_KEY=

# PostgreSQL DSN for Postgreyskull memory backend (F6+)
# Format: host=localhost port=5432 dbname=donkey user=donkey password=...
# DONKEY_PG_DSN=

# OpenRouter embedding key (needed when using Postgres memory backend)
# Defaults to OPENROUTER_API_KEY if unset — usually no need to set separately.
# OPENROUTER_EMBED_KEY=
