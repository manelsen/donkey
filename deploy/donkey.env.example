# Copy to ~/.config/donkey/donkey.env and fill in only what you use.
# Permissions: chmod 600 ~/.config/donkey/donkey.env

# Channels
TELEGRAM_BOT_TOKEN=
# Hugging Face Spaces block api.telegram.org. Point this to a Bot API-compatible
# proxy (for example a private Cloudflare Worker) when running there.
# DONKEY_TELEGRAM_API_BASE=https://your-worker.example
# Comma-separated Telegram chat ids allowed to use the bot. Empty allows every
# group; messages from any other chat are dropped before a session is created.
# DONKEY_TELEGRAM_ALLOWED_GROUPS=-1001234567890,-1000987654321
DISCORD_BOT_TOKEN=

# Access control
# open | pairing | allowlist. In `allowlist`, only users in
# ~/.donkey/state/dm_allowlist.txt are served (manage it with `donkey ctl`).
# DONKEY_DM_POLICY=open

# Providers
ZAI_API_KEY=
ZAI_CODING_API_KEY=
ZAI_ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# Credential pools: add the plural env next to any key to rotate over several
# accounts. A key that returns 401/429/quota errors cools down and the next
# request (or the same one, on a key-specific error) uses another.
# OPENAI_API_KEYS=key-a,key-b
# ANTHROPIC_API_KEYS=key-a,key-b

# Optional web search
# Enables the `web_search` tool via Brave Search API.
BRAVE_API_KEY=

# Tool approvals
# Defaults to bash, edit_file, fs_write, fs_mkdir, fs_copy, fs_move, fs_remove,
# text_replace, cp, mv, rm, mkdir, archive_*, execute_code.
# DONKEY_APPROVAL_TOOLS=bash,execute_code,fs_remove,fs_move
# Large fs_write/text_replace approvals show a path/bytes/sha1 preview instead
# of forcing the model to split the file. Default is "reject".
# DONKEY_APPROVAL_LARGE_WRITES=summary
# Hide the per-tool "🔧 tool [n]" progress messages; final answers and
# approval prompts are still sent.
# DONKEY_SUPPRESS_TOOL_PROGRESS=1

# Adaptive message debounce
# Fragments of a long message that arrive back-to-back are merged into one
# turn. The window grows with the number of fragments and with a short last
# fragment. Values below are the defaults (ms, except SHORT_MSG_CHARS).
# DONKEY_DEBOUNCE_MIN_MS=1200
# DONKEY_DEBOUNCE_MAX_MS=8000
# DONKEY_DEBOUNCE_PER_PART_MS=800
# DONKEY_DEBOUNCE_SHORT_MSG_CHARS=40
# DONKEY_DEBOUNCE_SHORT_EXT_MS=600

# Post-turn self-improvement review
# After a finished user turn the agent can look back and keep what is durable:
# a fact in MEMORY.md, a lesson in an installed skill's LEARNED.md. The review
# runs in the background, one per user at a time, and never gets tools.
# Memory is reviewed every N user turns, skills every N tool iterations; 0
# disables that half. Set ENABLED=0 to skip the automatic pass entirely.
# DONKEY_REVIEW_ENABLED=true
# DONKEY_REVIEW_MEMORY_INTERVAL=10
# DONKEY_REVIEW_SKILL_INTERVAL=10

# Optional runtime/storage overrides
# DONKEY_HTTP_PORT=0
# DONKEY_MAGMA_SQLITE_PATH=
# DONKEY_PG_DSN=
