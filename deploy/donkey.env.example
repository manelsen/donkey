# Copy to ~/.config/donkey/donkey.env and fill in only what you use.
# Permissions: chmod 600 ~/.config/donkey/donkey.env

# Channels
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Providers
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# Optional web search
# Enables the `web_search` tool via Brave Search API.
BRAVE_API_KEY=

# Optional runtime/storage overrides
# DONKEY_HTTP_PORT=0
# DONKEY_MAGMA_SQLITE_PATH=
# DONKEY_PG_DSN=
