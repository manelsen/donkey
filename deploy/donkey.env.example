# Copy to ~/.config/donkey/donkey.env and fill in only what you use.
# Permissions: chmod 600 ~/.config/donkey/donkey.env

# Channels
TELEGRAM_BOT_TOKEN=
# Hugging Face Spaces block api.telegram.org. Point this to a Bot API-compatible
# proxy (for example a private Cloudflare Worker) when running there.
# DONKEY_TELEGRAM_API_BASE=https://your-worker.example
DISCORD_BOT_TOKEN=

# Providers
ZAI_API_KEY=
ZAI_CODING_API_KEY=
ZAI_ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=

# Optional web search
# Enables the `web_search` tool via Brave Search API.
BRAVE_API_KEY=

# Tool approvals
# Defaults to bash, edit_file, fs_write, fs_mkdir, fs_copy, fs_move, fs_remove,
# text_replace, cp, mv, rm, mkdir, archive_*, execute_code.
# DONKEY_APPROVAL_TOOLS=bash,execute_code,fs_remove,fs_move
# Large fs_write/text_replace approvals show a path/bytes/sha1 preview instead
# of forcing the model to split the file. Default is "reject".
# DONKEY_APPROVAL_LARGE_WRITES=summary
# Hide the per-tool "🔧 tool [n]" progress messages; final answers and
# approval prompts are still sent.
# DONKEY_SUPPRESS_TOOL_PROGRESS=1

# Optional runtime/storage overrides
# DONKEY_HTTP_PORT=0
# DONKEY_MAGMA_SQLITE_PATH=
# DONKEY_PG_DSN=
