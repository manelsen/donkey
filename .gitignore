nimcache/
nimblecache/
.nimble/
*.exe
/donkey
/dist/

# Never commit plaintext secrets or the key file
*.enc
.secret_key
secrets.toml

# Testament artifacts: ignore compiled test binaries, allow source dirs and .nim files
testresults/
tests/**
!tests/**/
!tests/**/*.nim
!tests/**/*.nims
!tests/fixtures/**
!tests/test_groups.tsv
!tests/test_group_exceptions.tsv

# Build artifacts
donkey_release
src/donkey.out
src/donkey_pg.out
src/donkey/app/sandbox
src/donkey/infra/sandbox/wasm
tests/reranking/t_*_rerank
src/donkey/app/orchestrator
docs/*
!docs/hermes-mining/
!docs/hermes-mining/**
.ralph-tui/

# Downloaded SDKs (análise apenas, não são deps)
larksuiteoapi-node-sdk-*.tgz

# `nim c src/.../foo.nim` drops an extensionless ELF next to the source.
# Only Nim sources belong under src/ — same allow-list approach as tests/.
src/**
!src/**/
!src/**/*.nim
src/**/htmldocs/

# Editor/merge backups
*.orig
